# Dependencies
app/node_modules/

# Build output
app/dist/

# Generated at build time by vite.config.js pipelineDataPlugin
# (copied from data/ui_bundle.json so Vite ships it as a static asset)
app/public/ui_bundle.json

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Pipeline cache files — contain email addresses from public Bugzilla data.
# Regenerated on every CI run; not source data.
pipeline/ops_cache/comments_cache.json
pipeline/ops_cache/bugs_raw.json

# Pipeline operational cache — large files that grow daily.
# These live in GitHub Actions cache between runs, not in git.
# See .github/workflows/deploy.yml for cache restore/save steps.
pipeline/ops_cache/chrome_root_store_cache.json
pipeline/ops_cache/microsoft_ctl_cache.json
pipeline/ops_cache/cabf_members.json
pipeline/ops_cache/bugs_meta.json
pipeline/ops_cache/classifications.json
pipeline/ops_cache/cabforum_ballots.json
pipeline/ops_cache/bugs_meta.json
# IRQ pipeline cache — large and contain email/comment data from Bugzilla.
# irq_score_cache.json is committed as it contains only scored structured data.
pipeline/ops_cache/irq_comment_cache.json
pipeline/ops_cache/irq_ca_profiles.json

# CRL health scan output — 235MB+, too large for GitHub
data/crl_health.json

# CRL health history is large too, preserved via CI ops cache
data/crl_health_history.json
data/crl_health_events.json
